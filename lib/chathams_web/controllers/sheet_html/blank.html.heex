<%!--
  PROTOTYPE (issue #7): three ledger sheet variants on the blank sheet route,
  switched by ?variant=A|B|C. Every position is in mm so each page of a variant
  has the same box geometry, and the app can cut boxes by position.
--%>
<style>
  @page { size: A4 portrait; margin: 0; }
  :root { --ls-line: #b0b0b0; }
  html, body { background: #d4d4d4; margin: 0; }
  .ls-sheet { font-family: "Liberation Sans", Arial, Helvetica, sans-serif; color: #000; }
  .ls-page { position: relative; overflow: hidden; background: #fff; width: 210mm; height: 296.9mm; margin: 8mm auto; box-shadow: 0 1mm 4mm rgba(0,0,0,.25); }
  .ls-landscape .ls-page { width: 297mm; height: 209.9mm; }
  @media print {
    html, body { background: #fff; }
    .ls-page { margin: 0; box-shadow: none; }
    .ls-page + .ls-page { break-before: page; }
  }
  .ls-sheet *, .ls-sheet *::before { box-sizing: border-box; }
  .ls-sheet p, .ls-sheet ul { margin: 0; }
  .ls-sheet svg rect { shape-rendering: crispEdges; }
  /* A 10 mm marker plus a 1.667 mm quiet zone; the marker edge sits 7 mm in. */
  .ls-marker { position: absolute; width: 13.333mm; height: 13.333mm; }
  .ls-marker.tl { left: 5.333mm; top: 5.333mm; }
  .ls-marker.tr { right: 5.333mm; top: 5.333mm; }
  .ls-marker.br { right: 5.333mm; bottom: 5.333mm; }
  .ls-marker.bl { left: 5.333mm; bottom: 5.333mm; }
  .ls-box { border: 0.3mm solid var(--ls-line); background: #fff; flex: none; position: relative; }
  .ls-qr { flex: none; }
  .ls-qr svg { display: block; width: 100%; height: 100%; }
  .ls-header { position: absolute; top: 7mm; left: 20mm; right: 20mm; }
  .ls-title { font-size: 15pt; font-weight: 700; line-height: 1.1; }
  .ls-rules { columns: 2; column-gap: 6mm; font-size: 8.5pt; line-height: 1.3; margin-top: 1.5mm !important; padding-left: 4mm; list-style: disc; }
  .ls-sid { display: flex; gap: 1mm; }
  .ls-sid .ls-box { width: 8mm; height: 10mm; }
  .ls-sid-hint { font-size: 6.5pt; margin-top: 0.8mm !important; }
  .ls-name { font-weight: 700; line-height: 1.2; }
  .ls-sid-text { letter-spacing: 0.04em; }

  /* A: dense portrait. 10 rows at a 24 mm pitch from y = 36 mm. */
  .va-row { position: absolute; left: 7mm; width: 196mm; height: 20mm; display: flex; gap: 3mm; }
  .va-lead { width: 62mm; flex: none; display: flex; align-items: center; gap: 2.5mm; }
  .va-lead.blank { flex-direction: column; align-items: flex-start; justify-content: flex-start; gap: 0; }
  .va-qr { width: 12mm; height: 12mm; }
  .va-name { font-size: 10pt; }
  .va-sid { font-size: 9pt; }
  .va-boxes { display: flex; gap: 1.5mm; width: 131mm; flex: none; }
  .va-boxes .ls-box { width: 11.75mm; height: 20mm; }

  /* B: landscape wide. 8 rows at a 20 mm pitch from y = 31 mm. */
  .vb-row { position: absolute; left: 7mm; width: 283mm; height: 17mm; display: flex; gap: 3mm; }
  .vb-lead { width: 62mm; flex: none; display: flex; align-items: center; gap: 2.5mm; }
  .vb-lead.blank { flex-direction: column; align-items: flex-start; justify-content: flex-start; gap: 0; }
  .vb-qr { width: 14mm; height: 14mm; }
  .vb-name { font-size: 10pt; }
  .vb-sid { font-size: 9pt; }
  .vb-boxes { display: flex; gap: 1.5mm; width: 218mm; flex: none; }
  .vb-boxes .ls-box { width: 14.18mm; height: 17mm; }
  /* Same grey as the box line, so the $ goes away with the lines after thresholding. */
  .vb-dollar { position: absolute; left: 0.7mm; top: 0.3mm; font-size: 6pt; line-height: 1; color: var(--ls-line); }

  /* C: staff blocks. 6 blocks at a 40.5 mm pitch from y = 36 mm. */
  .vc-block { position: absolute; left: 7mm; width: 196mm; height: 37.4mm; }
  .vc-head { height: 12mm; display: flex; align-items: center; gap: 3mm; }
  .vc-qr { width: 12mm; height: 12mm; }
  .vc-name { font-size: 11pt; }
  .vc-sid { font-size: 10pt; }
  .vc-head .ls-sid-hint { font-size: 7.5pt; margin: 0 !important; max-width: 60mm; }
  .vc-line { display: flex; gap: 2mm; margin-top: 1.2mm; }
  .vc-line .ls-box { width: 22.75mm; height: 11.5mm; }

  /* B2: B's row and box geometry, refined type and header. Pure black on
     white: only text, thin rules and the light box lines carry ink. */
  /* Atkinson Hyperlegible has a slashed zero and no plain-zero alternate in
     its GSUB table, so the digits 0-9 come from Inter, whose default zero is plain. */
  @font-face { font-family: "Plain Digits"; font-weight: 100 900; unicode-range: U+0030-0039; src: url("/fonts/Inter-Variable.ttf"); }
  @font-face { font-family: "Atkinson Hyperlegible"; font-weight: 400; src: url("/fonts/AtkinsonHyperlegible-Regular.ttf"); }
  @font-face { font-family: "Atkinson Hyperlegible"; font-weight: 700; src: url("/fonts/AtkinsonHyperlegible-Bold.ttf"); }
  .vb2 { font-family: "Plain Digits", "Atkinson Hyperlegible", "DejaVu Sans", sans-serif; }
  .vb2-head { position: absolute; top: 7.5mm; left: 22mm; right: 22mm; }
  .vb2-titleline { display: flex; align-items: baseline; justify-content: space-between; }
  .vb2-title { font-size: 19pt; font-weight: 700; letter-spacing: -0.01em; line-height: 1; }
  .vb2-tagline { font-size: 9pt; }
  .vb2-rule { border-top: 0.25mm solid #000; margin-top: 1.8mm; }
  .vb2-rules { display: grid; grid-template-columns: 1fr 1fr 1fr 1.25fr; column-gap: 7mm; margin-top: 2mm; font-size: 8.5pt; line-height: 1.25; }
  .vb2-rules b { font-weight: 700; }
  .vb2-example { display: flex; gap: 2.5mm; align-items: flex-start; }
  .vb2-example .ls-box { width: 9mm; height: 9mm; display: flex; align-items: center; justify-content: center; }
  .vb2-hand { font-family: "DejaVu Serif", serif; font-style: italic; font-size: 12pt; line-height: 1; }
  .vb2-row { position: absolute; left: 7mm; width: 283mm; height: 17mm; display: flex; gap: 3mm; }
  .vb2-lead { position: relative; width: 62mm; flex: none; display: flex; align-items: center; gap: 3mm; }
  .vb2-lead.blank { flex-direction: column; align-items: flex-start; justify-content: flex-start; gap: 0; }
  .vb2-lead::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1.6mm; border-top: 0.2mm solid var(--ls-line); }
  .vb2-qr { width: 14mm; height: 14mm; }
  .vb2-name { font-size: 11pt; font-weight: 700; line-height: 1.15; }
  .vb2-sid { font-size: 9pt; letter-spacing: 0.14em; font-variant-numeric: tabular-nums; margin-top: 0.6mm !important; }
  .vb2 .ls-sid-hint { font-size: 7pt; }
  .vb2-boxes { display: flex; gap: 1.5mm; width: 218mm; flex: none; }
  .vb2-boxes .ls-box { width: var(--vb-box); height: 17mm; }
  .vb2-boxes .ls-box:not(.vb2-cash) + .vb2-cash { margin-left: 2.5mm; }
  .vb2-cols { position: absolute; top: 26.6mm; left: 72mm; display: flex; gap: 4mm; font-size: 8pt; font-weight: 700; line-height: 1; white-space: nowrap; }
  .vb2-cols p:last-child { text-align: center; }
  .vb2-foot { position: absolute; left: 22mm; right: 22mm; bottom: 7.5mm; display: flex; justify-content: space-between; align-items: baseline; font-size: 8pt; border-top: 0.2mm solid #000; padding-top: 1.5mm; }
  /* B5 has longer instructions. Three lines must end above the column headings at 26.6 mm. */
  .vb5-rules { grid-template-columns: 1.3fr 1fr 1fr 1fr; column-gap: 6mm; margin-top: 1.6mm; font-size: 8pt; line-height: 1.2; }
</style>
<style :if={@variant in ["B", "B2", "B3", "B4", "B5"]}>
  @page { size: A4 landscape; margin: 0; }
</style>

<div class={[
  "ls-sheet",
  @variant in ["B", "B2", "B3", "B4", "B5"] && "ls-landscape",
  @variant in ["B2", "B3", "B4", "B5"] && "vb2"
]}>
  <section :for={rows <- @pages} class="ls-page">
    <.aruco_marker id={0} class="tl" />
    <.aruco_marker id={1} class="tr" />
    <.aruco_marker id={2} class="br" />
    <.aruco_marker id={3} class="bl" />

    <header :if={@variant not in ["B2", "B3", "B4", "B5"]} class="ls-header">
      <p class="ls-title">Chathams ledger</p>
      <.instructions />
    </header>

    <header :if={@variant in ["B2", "B3", "B4", "B5"]} class="vb2-head">
      <div class="vb2-titleline">
        <p class="vb2-title">Chathams ledger</p>
        <p :if={@variant != "B5"} class="vb2-tagline">
          Write down what you buy. Pay it off from your balance.
        </p>
        <p :if={@variant == "B5"} class="vb2-tagline">
          Write down what you buy. We work out your balance.
        </p>
      </div>
      <div class="vb2-rule"></div>
      <div :if={@variant == "B2"} class="vb2-rules">
        <p><b>One amount per box.</b> Write it in dollars, for example 2.50.</p>
        <p><b>Not on the sheet, or your row is full?</b> Use a blank row at the end.</p>
        <p><b>Blank row:</b> write your sid in capitals, one letter in each box.</p>
        <div class="vb2-example">
          <div class="ls-box"><span class="vb2-hand">1.5</span></div>
          <p><b>Bought things together?</b> Write the total in one box: 50c and $1 is 1.5.</p>
        </div>
      </div>
      <div :if={@variant in ["B3", "B4"]} class="vb2-rules">
        <p><b>One amount per box.</b> Write it in dollars, for example 2.50.</p>
        <%!-- Two lines at most: a third line runs into the column headings. The blank
          row itself says to write the sid in capitals. --%>
        <p><b>Not on the sheet, or your row is full?</b> Use a blank row at the end.</p>
        <p>
          <b>Paid cash?</b> Write the amount in Cash paid and put the cash in the cash box.
        </p>
        <div class="vb2-example">
          <div class="ls-box"><span class="vb2-hand">1.5</span></div>
          <p><b>Bought things together?</b> Write the total in one box: 50c and $1 is 1.5.</p>
        </div>
      </div>
      <%!-- chathams.example stands for the portal URL that the admin sets. --%>
      <div :if={@variant == "B5"} class="vb2-rules vb5-rules">
        <div class="vb2-example">
          <div class="ls-box"><span class="vb2-hand">1.5</span></div>
          <p>
            <b>Buying?</b>
            Write the price in a Purchases box, for example 2.50. Several things at once? Write the total in one box.
          </p>
        </div>
        <p>
          <b>Paid cash?</b>
          Put the cash in the cash box. Write the amount in a Cash paid box, one payment per box.
        </p>
        <p>
          <b>Not listed, or row full?</b>
          Use a blank row at the end. Write your sid in capitals, one letter per box.
        </p>
        <p>
          <b>Your balance</b>
          Worked out for you after each collection. See it, with your history, at chathams.example.
        </p>
      </div>
    </header>

    <%= if @variant == "A" do %>
      <div
        :for={{person, i} <- Enum.with_index(rows)}
        class="va-row"
        style={"top: #{36 + i * 24}mm"}
      >
        <%= if person == :blank do %>
          <div class="va-lead blank"><.sid_cells /></div>
        <% else %>
          <div class="va-lead">
            <div class="ls-qr va-qr">{person.qr}</div>
            <div>
              <p class="ls-name va-name">{person.full_name}</p>
              <p class="ls-sid-text va-sid">{person.sid}</p>
            </div>
          </div>
        <% end %>
        <div class="va-boxes">
          <div :for={_ <- 1..10} class="ls-box"></div>
        </div>
      </div>
    <% end %>

    <%= if @variant == "B" do %>
      <div
        :for={{person, i} <- Enum.with_index(rows)}
        class="vb-row"
        style={"top: #{31 + i * 20}mm"}
      >
        <%= if person == :blank do %>
          <div class="vb-lead blank"><.sid_cells /></div>
        <% else %>
          <div class="vb-lead">
            <div class="ls-qr vb-qr">{person.qr}</div>
            <div>
              <p class="ls-name vb-name">{person.full_name}</p>
              <p class="ls-sid-text vb-sid">{person.sid}</p>
            </div>
          </div>
        <% end %>
        <div class="vb-boxes">
          <div :for={_ <- 1..14} class="ls-box"><span class="vb-dollar">$</span></div>
        </div>
      </div>
    <% end %>

    <%= if @variant in ["B2", "B3", "B4", "B5"] do %>
      <% {box_w, prices, cash_ws} =
        %{
          "B2" => {14.18, 14, []},
          "B3" => {14.0, 13, [14.0]},
          "B4" => {14.0, 12, [29.5]},
          "B5" => {14.0, 12, [14.0, 14.0]}
        }[@variant] %>
      <div :if={cash_ws != []} class="vb2-cols">
        <p style={"width: #{prices * box_w + (prices - 1) * 1.5}mm"}>Purchases</p>
        <p style={"width: #{Enum.sum(cash_ws) + (length(cash_ws) - 1) * 1.5}mm"}>Cash paid</p>
      </div>
      <div
        :for={{person, i} <- Enum.with_index(rows)}
        class="vb2-row"
        style={"top: #{31 + i * 20}mm"}
      >
        <%= if person == :blank do %>
          <div class="vb2-lead blank"><.sid_cells /></div>
        <% else %>
          <div class="vb2-lead">
            <div class="ls-qr vb2-qr">{person.qr}</div>
            <div>
              <p class="vb2-name">{person.full_name}</p>
              <p class="vb2-sid">{person.sid}</p>
            </div>
          </div>
        <% end %>
        <div class="vb2-boxes" style={"--vb-box: #{box_w}mm"}>
          <div :for={_ <- 1..prices} class="ls-box"></div>
          <div :for={w <- cash_ws} class="ls-box vb2-cash" style={"width: #{w}mm"}></div>
        </div>
      </div>
      <footer class="vb2-foot">
        <p><b>Chathams</b> staff shop</p>
        <p>Keep each amount inside its box. Admins scan this sheet after each collection.</p>
      </footer>
    <% end %>

    <%= if @variant == "C" do %>
      <div
        :for={{person, i} <- Enum.with_index(rows)}
        class="vc-block"
        style={"top: #{36 + i * 40.5}mm"}
      >
        <div class="vc-head">
          <%= if person == :blank do %>
            <.sid_cells hint={false} />
            <p class="ls-sid-hint">
              Write your sid in capitals, one letter in each box, for example N G U Y E N A
            </p>
          <% else %>
            <div class="ls-qr vc-qr">{person.qr}</div>
            <p class="ls-name vc-name">{person.full_name}</p>
            <p class="ls-sid-text vc-sid">{person.sid}</p>
          <% end %>
        </div>
        <div :for={_ <- 1..2} class="vc-line">
          <div :for={_ <- 1..8} class="ls-box"></div>
        </div>
      </div>
    <% end %>
  </section>
</div>

<nav
  :if={@show_switcher}
  id="variant-switcher"
  class="print:hidden fixed bottom-4 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 rounded-full bg-neutral-900 px-4 py-2 font-sans text-sm text-white shadow-lg"
>
  <a href={"?variant=#{@prev_variant}"} data-dir="prev" aria-label="Previous variant" class="px-1">
    ←
  </a>
  <span>{@variant} ({@variant_name})</span>
  <a href={"?variant=#{@next_variant}"} data-dir="next" aria-label="Next variant" class="px-1">
    →
  </a>
</nav>
<script :if={@show_switcher}>
  document.addEventListener("keydown", (e) => {
    if (e.target.closest && e.target.closest("input, textarea, [contenteditable]")) return;
    const dir = { ArrowLeft: "prev", ArrowRight: "next" }[e.key];
    const link = dir && document.querySelector(`#variant-switcher [data-dir="${dir}"]`);
    if (link) window.location.replace(link.href);
  });
</script>
